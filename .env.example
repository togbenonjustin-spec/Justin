# ============================================================================
# LoyerClair — Variables d'environnement (.env.example)
# Copiez ce fichier vers .env.local : cp .env.example .env.local
# NE COMMITEZ JAMAIS .env.local NI AUCUNE CLÉ SECRÈTE
# ============================================================================

# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Projet LoyerClair)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Clé serveur uniquement — NE JAMAIS préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mode des providers : "mock" (défaut, console sans clé externe) | "fedapay" | "webhook"
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
OTP_PROVIDER=mock

# FedaPay (Bénin — MTN MoMo, Moov Money, Celtiis Cash)
FEDAPAY_ENV=sandbox
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxxxxxxxxxxxxxxxx
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxx
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxxxxxxxxxxx

# Fournisseur SMS / WhatsApp Bénin (utilisé par le Send SMS Hook de Supabase ou API directe)
# Exemples compatibles Bénin : FasterMessage,InfoBip, Termii, Meta Cloud API WhatsApp, Africa's Talking
SMS_WEBHOOK_URL=
SMS_API_KEY=
SMS_SENDER_ID=LoyerClair
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
SUPABASE_SMS_HOOK_SECRET=

# Sécurité Cron Vercel (/api/cron/*)
CRON_SECRET=loyerclair-cron-secret-change-me
